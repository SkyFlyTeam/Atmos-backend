{
  "info": {
    "_postman_id": "7f48a8a2-74f2-4ffe-9cf2-6d3c9c0c2c91",
    "name": "TipoParametro API",
    "description": "Collection para testar as rotas de tipo_parametro.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Criar tipo parametro",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "name": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"json_id\": \"sensor-001\",\n  \"nome\": \"Temperatura\",\n  \"tipo\": \"float\",\n  \"offset\": 0.0,\n  \"fator\": 1.0,\n  \"polinomio\": null,\n  \"unidade\": \"C\",\n  \"alarme\": 50.0\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/tipo-parametro",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tipo-parametro"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test(\"Resposta contem pk\", function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json).to.have.property('pk');",
              "    pm.collectionVariables.set('tipoParametroPk', json.pk);",
              "});"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "Listar todos",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/tipo-parametro",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tipo-parametro"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200 ou 404\", function () {",
              "    pm.expect([200, 404]).to.include(pm.response.code);",
              "});"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "Buscar por pk",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/tipo-parametro/{{tipoParametroPk}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tipo-parametro",
            "{{tipoParametroPk}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200 ou 404\", function () {",
              "    pm.expect([200, 404]).to.include(pm.response.code);",
              "});"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "Atualizar por pk",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "name": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Temperatura ambiente\",\n  \"alarme\": 45.5\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/tipo-parametro/{{tipoParametroPk}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tipo-parametro",
            "{{tipoParametroPk}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Atualizacao retornada\", function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json).to.have.property('pk');",
              "});"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "Excluir por pk",
      "request": {
        "method": "DELETE",
        "url": {
          "raw": "{{baseUrl}}/tipo-parametro/{{tipoParametroPk}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tipo-parametro",
            "{{tipoParametroPk}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 204 ou 404\", function () {",
              "    pm.expect([204, 404]).to.include(pm.response.code);",
              "});"
            ]
          }
        }
      ],
      "response": []
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "default"
    },
    {
      "key": "tipoParametroPk",
      "value": "1",
      "type": "default"
    }
  ]
}
